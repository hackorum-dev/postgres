--
-- Tests for OR-clause expansion into UNION ALL Append paths
--
CREATE TABLE orexp_a (id int, val int);
CREATE TABLE orexp_b (x int, y int, val int);
INSERT INTO orexp_a VALUES
  (1, 10),
  (2, 20),
  (3, 30),
  (4, NULL),
  (5, 50);
INSERT INTO orexp_b VALUES
  (1, 99, 100),
  (99, 2, 200),
  (3, 3, 300),
  (4, 99, 400),
  (99, 99, 500),
  (NULL, NULL, 600);
-- check GUC parameter
SHOW or_expansion_limit;
 or_expansion_limit 
--------------------
 8
(1 row)

--
-- Disjunctive join conditions
--
-- disjunction of join keys
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
                        QUERY PLAN                         
-----------------------------------------------------------
 Sort
   Sort Key: a_1.id, b_1.x, b_1.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b_1.x = a_1.id)
               ->  Sort
                     Sort Key: b_1.x
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
         ->  Merge Join
               Merge Cond: (b_2.y = a_2.id)
               Join Filter: ((a_2.id = b_2.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_2.y
                     ->  Seq Scan on orexp_b b_2
               ->  Sort
                     Sort Key: a_2.id
                     ->  Seq Scan on orexp_a a_2
(20 rows)

SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
 id | x  | y  
----+----+----
  1 |  1 | 99
  2 | 99 |  2
  3 |  3 |  3
  4 |  4 | 99
(4 rows)

-- ensure results match when disabled
SET or_expansion_limit = 0;
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
                     QUERY PLAN                      
-----------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y
   ->  Nested Loop
         Join Filter: ((a.id = b.x) OR (a.id = b.y))
         ->  Seq Scan on orexp_a a
         ->  Materialize
               ->  Seq Scan on orexp_b b
(7 rows)

SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
 id | x  | y  
----+----+----
  1 |  1 | 99
  2 | 99 |  2
  3 |  3 |  3
  4 |  4 | 99
(4 rows)

RESET or_expansion_limit;
--
-- Cross-table filter predicates
--
-- cross-table disjunction with separate join condition
EXPLAIN (COSTS OFF)
SELECT a.id, a.val, b.val FROM orexp_a a JOIN orexp_b b ON a.id = b.x
WHERE a.val = 10 OR b.val = 300
ORDER BY a.id, a.val, b.val;
                      QUERY PLAN                      
------------------------------------------------------
 Sort
   Sort Key: a_1.id, a_1.val, b_1.val
   ->  Append
         ->  Hash Join
               Hash Cond: (b_1.x = a_1.id)
               ->  Seq Scan on orexp_b b_1
               ->  Hash
                     ->  Seq Scan on orexp_a a_1
                           Filter: (val = 10)
         ->  Hash Join
               Hash Cond: (a_2.id = b_2.x)
               ->  Seq Scan on orexp_a a_2
                     Filter: ((val = 10) IS NOT TRUE)
               ->  Hash
                     ->  Seq Scan on orexp_b b_2
                           Filter: (val = 300)
(16 rows)

SELECT a.id, a.val, b.val FROM orexp_a a JOIN orexp_b b ON a.id = b.x
WHERE a.val = 10 OR b.val = 300
ORDER BY a.id, a.val, b.val;
 id | val | val 
----+-----+-----
  1 |  10 | 100
  3 |  30 | 300
(2 rows)

--
-- Aggregation and grouping
--
-- GROUP BY over an expanded join
EXPLAIN (COSTS OFF)
SELECT a.id, count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
ORDER BY a.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a_1.id
   ->  HashAggregate
         Group Key: a_1.id
         ->  Append
               ->  Merge Join
                     Merge Cond: (b_1.x = a_1.id)
                     ->  Sort
                           Sort Key: b_1.x
                           ->  Seq Scan on orexp_b b_1
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
               ->  Merge Join
                     Merge Cond: (b_2.y = a_2.id)
                     Join Filter: ((a_2.id = b_2.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: b_2.y
                           ->  Seq Scan on orexp_b b_2
                     ->  Sort
                           Sort Key: a_2.id
                           ->  Seq Scan on orexp_a a_2
(22 rows)

SELECT a.id, count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
ORDER BY a.id;
 id | count 
----+-------
  1 |     1
  2 |     1
  3 |     1
  4 |     1
(4 rows)

-- zero-column target
EXPLAIN (COSTS OFF)
SELECT count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y;
                        QUERY PLAN                         
-----------------------------------------------------------
 Aggregate
   ->  Append
         ->  Merge Join
               Merge Cond: (b_1.x = a_1.id)
               ->  Sort
                     Sort Key: b_1.x
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
         ->  Merge Join
               Merge Cond: (b_2.y = a_2.id)
               Join Filter: ((a_2.id = b_2.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_2.y
                     ->  Seq Scan on orexp_b b_2
               ->  Sort
                     Sort Key: a_2.id
                     ->  Seq Scan on orexp_a a_2
(19 rows)

SELECT count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y;
 count 
-------
     4
(1 row)

-- non-aggregate HAVING clause
EXPLAIN (COSTS OFF)
SELECT a.id, count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
HAVING a.id > 1
ORDER BY a.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a_1.id
   ->  HashAggregate
         Group Key: a_1.id
         ->  Append
               ->  Merge Join
                     Merge Cond: (a_1.id = b_1.x)
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
                                 Filter: (id > 1)
                     ->  Sort
                           Sort Key: b_1.x
                           ->  Seq Scan on orexp_b b_1
               ->  Merge Join
                     Merge Cond: (a_2.id = b_2.y)
                     Join Filter: ((a_2.id = b_2.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: a_2.id
                           ->  Seq Scan on orexp_a a_2
                                 Filter: (id > 1)
                     ->  Sort
                           Sort Key: b_2.y
                           ->  Seq Scan on orexp_b b_2
(24 rows)

-- aggregate HAVING clause
EXPLAIN (COSTS OFF)
SELECT a.id, count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
HAVING count(*) > 1
ORDER BY a.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a_1.id
   ->  HashAggregate
         Group Key: a_1.id
         Filter: (count(*) > 1)
         ->  Append
               ->  Merge Join
                     Merge Cond: (b_1.x = a_1.id)
                     ->  Sort
                           Sort Key: b_1.x
                           ->  Seq Scan on orexp_b b_1
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
               ->  Merge Join
                     Merge Cond: (b_2.y = a_2.id)
                     Join Filter: ((a_2.id = b_2.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: b_2.y
                           ->  Seq Scan on orexp_b b_2
                     ->  Sort
                           Sort Key: a_2.id
                           ->  Seq Scan on orexp_a a_2
(23 rows)

-- grouping sets
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, grouping (a.id), count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY GROUPING SETS ((a.id), (b.x), ())
ORDER BY 1, 2, 3, 4;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a_1.id, b_1.x, (GROUPING(a_1.id)), (count(*))
   ->  MixedAggregate
         Hash Key: a_1.id
         Hash Key: b_1.x
         Group Key: ()
         ->  Append
               ->  Merge Join
                     Merge Cond: (b_1.x = a_1.id)
                     ->  Sort
                           Sort Key: b_1.x
                           ->  Seq Scan on orexp_b b_1
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
               ->  Merge Join
                     Merge Cond: (b_2.y = a_2.id)
                     Join Filter: ((a_2.id = b_2.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: b_2.y
                           ->  Seq Scan on orexp_b b_2
                     ->  Sort
                           Sort Key: a_2.id
                           ->  Seq Scan on orexp_a a_2
(24 rows)

SELECT a.id, b.x, grouping (a.id), count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY GROUPING SETS ((a.id), (b.x), ())
ORDER BY 1, 2, 3, 4;
 id | x  | grouping | count 
----+----+----------+-------
  1 |    |        0 |     1
  2 |    |        0 |     1
  3 |    |        0 |     1
  4 |    |        0 |     1
    |  1 |        1 |     1
    |  3 |        1 |     1
    |  4 |        1 |     1
    | 99 |        1 |     1
    |    |        1 |     4
(9 rows)

--
-- Subqueries, views, and derived tables
--
-- pulled-up simple subquery
EXPLAIN (COSTS OFF)
SELECT x.id, b.y FROM (SELECT id, val FROM orexp_a) x, orexp_b b
WHERE x.id = b.x OR x.val = b.y
ORDER BY 1, 2;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: orexp_a_1.id, b_1.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b_1.x = orexp_a_1.id)
               ->  Sort
                     Sort Key: b_1.x
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: orexp_a_1.id
                     ->  Seq Scan on orexp_a orexp_a_1
         ->  Merge Join
               Merge Cond: (b_2.y = orexp_a_2.val)
               Join Filter: ((orexp_a_2.id = b_2.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_2.y
                     ->  Seq Scan on orexp_b b_2
               ->  Sort
                     Sort Key: orexp_a_2.val
                     ->  Seq Scan on orexp_a orexp_a_2
(20 rows)

SELECT x.id, b.y FROM (SELECT id, val FROM orexp_a) x, orexp_b b
WHERE x.id = b.x OR x.val = b.y
ORDER BY 1, 2;
 id | y  
----+----
  1 | 99
  3 |  3
  4 | 99
(3 rows)

-- pulled-up subquery containing outer join
CREATE TABLE orexp_c (id int, val int);
CREATE TABLE orexp_d (id int, val int);
INSERT INTO orexp_c VALUES (1, 10), (2, 20), (3, NULL);
INSERT INTO orexp_d VALUES (1, 100), (3, 300), (5, 500);
EXPLAIN (COSTS OFF)
SELECT x.cid, b.y FROM (SELECT c.id AS cid, c.val AS cval, d.val + 1 AS dval
                        FROM orexp_c c LEFT JOIN orexp_d d ON c.id = d.id) x,
                      orexp_b b
WHERE x.dval = b.y OR x.cid = b.x
ORDER BY 1, 2;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: c_1.id, b_1.y
   ->  Append
         ->  Merge Join
               Merge Cond: (c_1.id = d_1.id)
               ->  Sort
                     Sort Key: c_1.id
                     ->  Seq Scan on orexp_c c_1
               ->  Sort
                     Sort Key: d_1.id
                     ->  Merge Join
                           Merge Cond: (b_1.y = ((d_1.val + 1)))
                           ->  Sort
                                 Sort Key: b_1.y
                                 ->  Seq Scan on orexp_b b_1
                           ->  Sort
                                 Sort Key: ((d_1.val + 1))
                                 ->  Seq Scan on orexp_d d_1
         ->  Merge Right Join
               Merge Cond: (d_2.id = c_2.id)
               Filter: (((d_2.val + 1) = b_2.y) IS NOT TRUE)
               ->  Sort
                     Sort Key: d_2.id
                     ->  Seq Scan on orexp_d d_2
               ->  Materialize
                     ->  Merge Join
                           Merge Cond: (b_2.x = c_2.id)
                           ->  Sort
                                 Sort Key: b_2.x
                                 ->  Seq Scan on orexp_b b_2
                           ->  Sort
                                 Sort Key: c_2.id
                                 ->  Seq Scan on orexp_c c_2
(33 rows)

SELECT x.cid, b.y FROM (SELECT c.id AS cid, c.val AS cval, d.val + 1 AS dval
                        FROM orexp_c c LEFT JOIN orexp_d d ON c.id = d.id) x,
                      orexp_b b
WHERE x.dval = b.y OR x.cid = b.x
ORDER BY 1, 2;
 cid | y  
-----+----
   1 | 99
   3 |  3
(2 rows)

-- view expanded into pulled-up subquery
CREATE VIEW orexp_v AS
  SELECT a.id AS aid, a.val AS aval, b.x AS bx FROM orexp_a a, orexp_b b;
EXPLAIN (COSTS OFF)
SELECT v.aid, b.y FROM orexp_v v, orexp_b b
WHERE v.aval = b.y OR v.bx = b.y
ORDER BY 1, 2;
                         QUERY PLAN                         
------------------------------------------------------------
 Sort
   Sort Key: a_1.id, b_2.y
   ->  Append
         ->  Nested Loop
               ->  Merge Join
                     Merge Cond: (b_2.y = a_1.val)
                     ->  Sort
                           Sort Key: b_2.y
                           ->  Seq Scan on orexp_b b_2
                     ->  Sort
                           Sort Key: a_1.val
                           ->  Seq Scan on orexp_a a_1
               ->  Materialize
                     ->  Seq Scan on orexp_b b_3
         ->  Nested Loop
               Join Filter: ((a_2.val = b_4.y) IS NOT TRUE)
               ->  Merge Join
                     Merge Cond: (b_5.x = b_4.y)
                     ->  Sort
                           Sort Key: b_5.x
                           ->  Seq Scan on orexp_b b_5
                     ->  Sort
                           Sort Key: b_4.y
                           ->  Seq Scan on orexp_b b_4
               ->  Materialize
                     ->  Seq Scan on orexp_a a_2
(26 rows)

SELECT v.aid, b.y FROM orexp_v v, orexp_b b
WHERE v.aval = b.y OR v.bx = b.y
ORDER BY 1, 2;
 aid | y  
-----+----
   1 |  3
   1 | 99
   1 | 99
   1 | 99
   1 | 99
   1 | 99
   1 | 99
   2 |  3
