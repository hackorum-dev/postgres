\luacode
\luaset a,b,c foo 10 20 30
\echo :a :b :c
10 20 30
\luaset a , b , c foo 10 20 30
\echo :a :b :c
10 20 30
\luaset a ,b , c foo 10 20 30
\echo :a :b :c
10 20 30
\luaset a,b , c foo 10 20 30
\echo :a :b :c
10 20 30
\luaset a ,b, c foo 10 20 30
\echo :a :b :c
10 20 30
