# ----------
# src/test/regress/parallel_schedule
#
# Most test scripts can be run after running just test_setup and possibly
# create_index.  Exceptions to this rule are documented below.
#
# By convention, we put no more than twenty tests in any one parallel group;
# this limits the number of connections needed to run the tests.
# ----------

# required setup steps
test: test_setup

# ----------
# The first group of parallel tests
# ----------
test concurrently: \
    database \
    boolean \
    char \
    name \
    varchar \
    text \
    int2 \
    int4 \
    int8 \
    oid \
    bit \
    numeric \
    txid \
    uuid \
    enum \
    money \
    pg_lsn \
    regproc
# float4 and float8 create immutable parallel-unsafe I/O functions
test sequentially: (float4 float8) opr_sanity

# multirangetypes depends on rangetypes.
# multirangetypes and strings must finish before type_sanity
# (strings sets text column storage to external).
test sequentially: rangetypes (multirangetypes strings) type_sanity

# ----------
# The second group of parallel tests
# ----------
test concurrently: \
    md5 \
    numerology

# geometry depends on point, lseg, line, box, path, polygon, circle
test sequentially: ( \
    point \
    lseg \
    line \
    box \
    path \
    polygon \
    circle \
) geometry

# horology depends on date, time, timetz, timestamp, timestamptz, interval
test sequentially: ( \
    date \
    time \
    timetz \
    timestamp \
    timestamptz \
    interval \
) horology

test concurrently: \
    inet \
    macaddr \
    macaddr8

# ----------
# Another group of parallel tests
# ----------
test concurrently: \
    tstypes \
    regex \
    misc_sanity \
    comments \
    expressions \
    unicode \
    xid \
    mvcc \
    stats_import \
    pg_ndistinct \
    pg_dependencies \
    oid8 \
    encoding \
    euc_kr

# ----------
# Load huge amounts of data
# We should split the data files into single files and then
# execute two copy tests in parallel, to check that copy itself
# is concurrent safe.
# ----------
test: \
    copy \
    copyselect \
    copydml \
    copyencoding \
    insert \
    insert_conflict

# ----------
# More groups of parallel tests
# Note: many of the tests in later groups depend on create_index
# ----------
test: \
    create_function_c \
    create_misc \
    create_operator \
    create_procedure \
    create_table \
    create_type \
    create_schema

test: \
    create_index \
    create_index_spgist \
    create_view \
    index_including \
    index_including_gist

# ----------
# sanity_check does a vacuum, affecting the sort order of SELECT *
# results. So it should not run parallel to other tests.
# ----------
test: sanity_check
# ----------
# Another group of parallel tests
# ----------
test concurrently: \
    create_cast \
    triggers \
    select \
    typed_table \
    vacuum \
    drop_if_exists \
    roleattributes \
    hash_func \
    errors \
    infinite_recurse

# ----------
# Another group of parallel tests
# aggregates depends on create_aggregate
# join depends on create_misc
# ----------
test concurrently: \
    select_into \
    select_distinct \
    select_distinct_on \
    select_implicit \
    select_having \
    subselect \
    union \
    case \
    transactions \
    random \
    portals \
    arrays \
    btree_index \
    delete \
    namespace \
    prepared_xacts

# ----------
# Another group of parallel tests
# ----------
test concurrently: \
    gin \
    gist \
    spgist \
    init_privs \
    security_label \
    collate \
    matview \
    lock \
    object_address \
    tablesample \
    groupingsets \
    drop_operator \
    password \
    identity \
    join_hash

# ----------
# Additional BRIN tests
# ----------
test concurrently: \
    brin_bloom \
    brin_multi

# ----------
# Another group of parallel tests
# ----------
test concurrently: \
    alter_operator \
    create_table_like \
    create_role \
    misc_functions \
    async \
    dbsize \
    nls \
    sysviews \
    tsrf \
    tid tidscan tidrangescan \
    collate.utf8 \
    incremental_sort \
    without_overlaps

# collate.icu.utf8, collate.linux.utf8 and collate.windows.win1252
# all create role regress_test_role
# psql depends on create_am
# amutils depends on geometry, create_index_spgist, hash_index, brin
test sequentially: \
    (hash_index brin) amutils
test sequentially: \
    create_am (psql_crosstab psql_pipeline)
test sequentially: \
    collate.icu.utf8 collate.linux.utf8 collate.windows.win1252
# generated_stored and generated_virtual both create role regress_user11
test sequentially: generated_stored generated_virtual
test concurrently: \
    rules

# aggregates uses the functions create_aggregate defines
test sequentially: create_aggregate aggregates
# constraints and replica_identity both create index pk
test sequentially: constraints replica_identity
# inherit and update both create list_parted
test sequentially: inherit update
# privileges and rowsecurity both create type t1.
# privileges also revokes USAGE on language sql, which merge,
# create_function_sql, and alter_generic need.
test sequentially: privileges (rowsecurity merge create_function_sql alter_generic)

# ----------
# Run these alone so they don't run out of parallel workers
# select_parallel depends on create_misc
# ----------
test: select_parallel
# updatable_views and join both create type t1
test sequentially: updatable_views join
test: write_parallel
# psql needs create_am and language sql; both are finished before this fence.
# psql and misc both touch onek.
test sequentially: (stats_ext psql) misc
test: vacuum_parallel

# Run this alone, because concurrent DROP TABLE would make non-superuser
# "ANALYZE;" fail with "relation with OID $n does not exist".
test: maintain_every

# no relation related tests can be put in this group
test: \
    publication \
    subscription

# ----------
# Another group of parallel tests
# select_views depends on create_view
# ----------
test concurrently: \
    select_views \
    portals_p2 \
    portals_inflight \
    foreign_key \
    dependency \
    guc \
    bitmapops \
    combocid \
    tsearch \
    tsdicts \
    window \
    xmlmap \
    functional_deps \
    advisory_lock \
    indirect_toast \
    equivclass \
    stats_rewrite

# ----------
# Another group of parallel tests (JSON related)
# ----------
test concurrently: \
    json \
    jsonb \
    json_encoding \
    jsonpath \
    jsonpath_encoding \
    jsonb_jsonpath \
    sqljson \
    sqljson_queryfuncs \
    sqljson_jsontable

# ----------
# Another group of parallel tests
# with depends on create_misc
# NB: temp.sql does reconnects which transiently uses 2 connections,
# so keep this parallel group to at most 19 tests
# ----------
test concurrently: \
    plancache \
    limit \
    plpgsql \
    copy2 \
    temp \
    domain \
    rangefuncs \
    prepare \
    conversion \
    truncate \
    sequence \
    polymorphism \
    rowtypes \
    returning \
    largeobject \
    with \
    xml

# partition_prune's temp tables p1 and p2 are visible to alter_table's
# pg_class scan
test sequentially: partition_prune alter_table

# ----------
# Another group of parallel tests
#
# The stats test resets stats, so nothing else needing stats access can be in
# this group.
# ----------
test concurrently: \
    partition_join \
    reloptions \
    hash_part \
    indexing \
    partition_aggregate \
    tuplesort \
    explain \
    memoize \
    stats \
    predicate \
    numa \
    eager_aggregate \
    planner_est \
    attribute_version
# ----------
# Another group of parallel tests (compression)
# ----------
test concurrently: \
    compression \
    compression_lz4 \
    compression_pglz

# cluster creates clstr_fdw, which foreign_data expects to be gone
test sequentially: cluster foreign_data


# alter_table creates p1, at_tab1, and attbl, which partition_info and
# alter_column_type also create. Keep those two behind this fence.
test: \
    alter_column_type \
    partition_info

# rowtypes_alter relies on cached plans surviving across statements, which
# concurrent DDL can prevent, and on parallel workers being available, so run
# it by itself
test: rowtypes_alter

# event_trigger depends on create_am and cannot run concurrently with
# any test that runs DDL
# oidjoins is read-only, though, and should run late for best coverage
test: \
    oidjoins \
    event_trigger


# event_trigger_login cannot run concurrently with any other tests because
# on-login event handling could catch connection of a concurrent test.
test: \
    event_trigger_login

# this test also uses event triggers, so likewise run it by itself
test: \
    fast_default

# run tablespace test at the end because it drops the tablespace created during
# setup that other tests may use.
test: \
    tablespace
