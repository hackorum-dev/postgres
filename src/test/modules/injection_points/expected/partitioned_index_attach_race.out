step ctrl_lock: 
	BEGIN;
	LOCK TABLE partc1 IN ACCESS EXCLUSIVE MODE;

step ctrl_gate: 
	DO $$
	DECLARE
		n integer := 0;
	BEGIN
		WHILE NOT EXISTS
		      (SELECT 1 FROM pg_stat_activity
		        WHERE wait_event = 'alter-index-attach-complete')
		LOOP
			PERFORM pg_sleep(0.01);
			n := n + 1;
			IF n > 3000 THEN
				RAISE EXCEPTION 's1 never reached the injection point';
			END IF;
		END LOOP;
	END
	$$;

