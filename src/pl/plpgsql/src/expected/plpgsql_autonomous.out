LANGUAGE plpgsql
AS $$
BEGIN
  INSERT INTO tbl VALUES (2);
  INSERT INTO tbl VALUES (3);
END;
$$;
CREATE FUNCTION func_2()
RETURNS void
LANGUAGE plpgsql
AS $$
BEGIN
  INSERT INTO tbl VALUES (30);
  CALL proc_no_trans();
  INSERT INTO tbl VALUES (40);
END;
$$;
