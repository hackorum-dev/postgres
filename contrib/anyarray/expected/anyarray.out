(1 row)

SELECT anyarray_idx(ARRAY[10, 20, 30]::int8[], 20::int8);
 anyarray_idx 
--------------
            2
(1 row)

SELECT anyarray_idx(ARRAY[10, 20, 30]::int8[], 99::int8);
