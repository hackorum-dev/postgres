SELECT amname, opcname FROM pg_opclass opc
LEFT JOIN pg_am am ON am.oid = opcmethod
WHERE opc.opcname LIKE '%anyquery_gin_ops' AND NOT amvalidate(opc.oid);
 amname | opcname 
--------+---------
(0 rows)

