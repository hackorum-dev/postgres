--
-- SQL/JSON
--
SET pg_stat_statements.track_utility = FALSE;
-- The table is kept empty, as only the query IDs and texts matter here.
CREATE TABLE pgss_sqljson_tab (js jsonb, t text, b bytea);
--
-- SQL/JSON query functions
--
